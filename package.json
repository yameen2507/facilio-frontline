{
  "name": "frontline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Facilio Vibe app for the pre-contract funnel: lead, account, site survey, quote, approval and signature, handing off to Facilio FSM.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.backend.json",
    "bundle": "node scripts/bundle.mjs",
    "push": "node scripts/push.mjs",
    "build:frontend": "node scripts/build-frontend.mjs",
    "typecheck:frontend": "tsc -p frontend/tsconfig.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:frontend"
  },
  "dependencies": {
    "@facilio/vibe-sdk": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
